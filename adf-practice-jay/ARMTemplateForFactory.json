										}
									},
									{
										"source": {
											"path": "$['location']['latitude']"
										},
										"sink": {
											"name": "latitude",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['location']['street']['id']"
										},
										"sink": {
											"name": "Street Id"
										}
									},
									{
										"source": {
											"path": "$['location']['street']['name']"
										},
										"sink": {
											"name": "Street Name"
										}
									},
									{
										"source": {
											"path": "$['location']['longitude']"
										},
										"sink": {
											"name": "longitude",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['context']"
										},
										"sink": {
											"name": "context",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['outcome_status']['category']"
										},
										"sink": {
											"name": "outcome_cat",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['outcome_status']['date']"
										},
										"sink": {
											"name": "outcome_date",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['persistent_id']"
										},
										"sink": {
											"name": "persistent_id",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['id']"
										},
										"sink": {
											"name": "id"
										}
									},
									{
										"source": {
											"path": "$['location_subtype']"
										},
										"sink": {
											"name": "location_subtype",
											"type": "String"
										}
									},
									{
										"source": {
											"path": "$['month']"
										},
										"sink": {
											"name": "month",
											"type": "String"
										}
									}
								]
							}
						},
						"inputs": [
							{
								"referenceName": "DS_Rest_API",
								"type": "DatasetReference",
								"parameters": {
									"Relative_url": "crimes-street/all-crime?date=2024-01&lat=52.629729&lng=-1.131592"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_API_azure_sql",
								"type": "DatasetReference",
								"parameters": {
									"Table_name": "StreetCrime"
								}
							}
						]
					},
					{
						"name": "Get Metadata1",
						"type": "GetMetadata",
						"dependsOn": [],
